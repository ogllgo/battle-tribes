{
   "license": "UNLICENSED",
   "type": "module",
   "scripts": {
      "start": "npm run build && node dist/server/server.js",
      "build": "tsc",
      "perf": "NODE_OPTIONS='--cpu-prof --cpu-prof-interval=100' node dist/server/server.js",
      "gigaperf": "node --log-deopt --redirect-code-traces --redirect-code-traces-to=./NUL --log-ic --log-maps --log-maps-details --log-code --log-source-code --prof --log-internal-timer-events --detailed-line-info --logfile=v8.log --no-logfile-per-isolate dist/server/server.js",
      "debug": "nodemon --inspect",
      "time": "node -r ts-node/register -r tsconfig-paths/register --expose-gc src/server.ts timed",
      "perfticks": "node -r ts-node/register -r tsconfig-paths/register --prof src/server/server.ts",
      "lint": "npx eslint ."
   },
   "dependencies": {
      "@eslint/js": "^10.0.1",
      "@types/ws": "^8.18.1",
      "battletribes-shared": "file:../shared",
      "eslint": "^10.6.0",
      "express": "^5.2.1",
      "socket.io": "^4.8.3",
      "tsx": "^4.23.0",
      "ws": "^8.21.0"
   },
   "devDependencies": {
      "@types/express": "^5.0.6",
      "madge": "^8.0.0",
      "nodemon": "^3.1.14",
      "ts-node": "^10.9.2",
      "ts-node-dev": "^2.0.0",
      "tsconfig-paths": "^4.2.0",
      "typescript-eslint": "^8.63.0"
   }
}
